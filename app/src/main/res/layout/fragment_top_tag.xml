<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="vm"
            type="com.example.devblogapplication.viewmodel.TopTagViewModel" />

        <variable
            name="listener"
            type="com.example.devblogapplication.view.adapter.RankTagAdapter.OnTagActionListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context=".view.fragment.TopTagFragment"
        android:padding="10dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trending Tags"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="@{vm.topTags == null ? View.GONE : View.VISIBLE}"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTopTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:listener="@{listener}"
            app:tags="@{vm.topTags}"
            android:visibility="@{vm.topTags == null ? View.GONE : View.VISIBLE}"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Tag"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="@{vm.allTags == null ? View.GONE : View.VISIBLE}"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAllTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:allTag="@{vm.allTags}"
            app:listener="@{listener}"
            android:visibility="@{vm.allTags == null ? View.GONE : View.VISIBLE}"/>
        <ProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="@{vm.allTags == null ? View.VISIBLE : View.GONE}"/>
    </LinearLayout>
</layout>