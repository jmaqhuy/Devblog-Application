<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="user"
            type="com.example.devblogapplication.model.UserDTO" />
        <variable
            name="listener"
            type="com.example.devblogapplication.view.adapter.UserListAdapter.OnUserClickListener" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:onClick="@{() -> listener.onUserClick(user)}">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/userAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:imageUrl="@{user.avatar}"
            android:contentDescription="@{user.fullName}"
            android:src="@drawable/sample_avatar"
            android:scaleType="centerCrop"
            app:riv_oval="true"/>
        <TextView
            android:id="@+id/userFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/userAvatar"
            app:layout_constraintStart_toEndOf="@id/userAvatar"
            android:layout_marginStart="10dp"
            android:text="@{user.fullName}"
            android:textSize="17sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/userAvatar"
            app:layout_constraintStart_toEndOf="@id/userAvatar"
            android:layout_marginStart="10dp"
            android:text="@{user.username}"
            android:textStyle="italic"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Follow"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/border_bg"
            android:backgroundTint="@color/blue"
            android:paddingHorizontal="13dp"
            android:paddingVertical="5dp"
            app:layout_constraintTop_toTopOf="@id/userAvatar"
            app:layout_constraintBottom_toBottomOf="@id/userAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="@{() -> listener.onFollowClick(user)}"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>